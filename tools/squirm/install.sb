;; Squirm's sandbox for installing installer.R's packages (macOS sandbox-exec), written by the setup with @SQ@ and @UH@
;; filled in. The network is open, to reach CRAN; reads under /Users are kept to Squirm's clone and library, as for a
;; job, and writes to the library alone. Later rules win over earlier ones.
(version 1)
(allow default)
(deny file-read* (subpath "/Users") (subpath "/Volumes"))
(allow file-read* (literal "/Users") (literal "@UH@") (literal "@SQ@") (subpath "@SQ@/bxd") (subpath "@SQ@/Rlib"))
(deny file-write* (subpath "/Users") (subpath "/Volumes") (subpath "/Library") (subpath "/Applications") (subpath "/opt"))
(allow file-write* (subpath "@SQ@/Rlib") (subpath "@SQ@/bxd/.squirm_home"))
